# Copy to .env and fill in real values:  cp .env.example .env
# This file IS committed. .env is NOT.

# development | test | production
NODE_ENV=development

PORT=5000

# Must match the postgres service in docker-compose.yml
DATABASE_URL="postgresql://restaurant:restaurant123@localhost:5432/restaurant_db"

# Minimum 32 characters. Generate a UNIQUE value per environment, and a
# DIFFERENT one for each of the two secrets below:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Access tokens are short-lived; refresh tokens are long-lived but revocable.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor (10-15). Higher is slower to crack and slower to log in.
BCRYPT_ROUNDS=12

# IANA timezone the restaurant trades in. EVERY report bucket and every
# "today" boundary is measured in this zone, so the dashboard headline and the
# sales chart always describe the same set of orders — regardless of the zone
# the server or the managed database happens to run in (usually UTC).
REPORT_TIMEZONE=Asia/Kolkata

# Interactive API docs at /api/docs (Swagger UI) and /api/docs/openapi.json.
# On by default: the spec describes endpoints that are already reachable and
# grants no access, since every protected route is still behind a token and a
# permission. Set to false to withhold the map anyway.
API_DOCS=true

# Used by `npm run seed` only. Change the password before seeding anything
# that is not a throwaway local database.
SEED_ADMIN_EMAIL="admin@restaurant.local"
SEED_ADMIN_PASSWORD=""
