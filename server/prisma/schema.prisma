// Restaurant QR Ordering & Management System — data model.
//
// Conventions used throughout:
//   - cuid() ids: non-sequential, so record counts and volumes are not
//     inferable from a URL, and rows are not enumerable.
//   - Money is Decimal(10,2), never Float. Binary floating point cannot
//     represent 19.99 exactly and accumulates error across aggregates.
//   - deletedAt marks soft deletes on catalogue data referenced by orders.
//   - Timestamps: createdAt/updatedAt on mutable rows; append-only tables
//     (AuditLog) deliberately have no updatedAt.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection URL is supplied by prisma.config.ts, which reads
  // DATABASE_URL from .env. Prisma 7 keeps secrets out of the schema.
}

// ===========================================================================
// Enums
//
// Modelled as database enums rather than free-text strings so an invalid
// status is rejected by Postgres itself, not merely by application code.
// ===========================================================================

/// Lifecycle of an order. Drives the Kitchen Display System columns.
enum OrderStatus {
  PENDING // placed by customer, not yet acknowledged
  CONFIRMED // accepted by staff
  PREPARING // in the kitchen
  READY // awaiting pickup/serving
  SERVED // delivered to the table
  CANCELLED // terminal; see cancelReason
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  ONLINE
}

/// Lifecycle of a single payment attempt against an order.
enum PaymentTxnStatus {
  PENDING // intent created, awaiting confirmation from the provider
  SUCCESS // confirmed captured
  FAILED // declined or abandoned
  REFUNDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  INACTIVE // withdrawn from service; QR stops resolving
}

/// Lifecycle of a table booking.
enum ReservationStatus {
  PENDING // requested by a guest, not yet accepted
  CONFIRMED // the house has held a table
  SEATED // the party has arrived
  COMPLETED // they dined and left
  CANCELLED // called off by either side
  NO_SHOW // never arrived; tracked separately for reporting
}

enum NotificationType {
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  SYSTEM
}

/// How a menu offer reduces a dish's price.
enum OfferType {
  PERCENTAGE // e.g. 20 -> 20% off
  FIXED // e.g. 100 -> ₹100 off
}

// ===========================================================================
// Identity & access control
// ===========================================================================

/// Staff-side account: super admin, admin, kitchen, or waiter.
/// Customers are NOT users — see the Customer model.
model User {
  id String @id @default(cuid())

  email        String  @unique
  /// bcrypt hash. The plaintext password is never stored or logged.
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  roleId String
  /// Restrict: a role still assigned to users cannot be deleted.
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  auditLogs         AuditLog[]
  notifications     Notification[]
  notificationReads NotificationRead[]
  handledOrders     Order[]            @relation("OrderHandledBy")
  refreshTokens     RefreshToken[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([roleId])
  @@index([deletedAt])
  @@map("users")
}

/// An issued refresh token, stored so sessions can be revoked.
///
/// A pure JWT refresh token is valid until it expires and cannot be cancelled,
/// so "log out everywhere" and "disable this account now" become impossible.
/// Persisting them makes revocation a database write.
model RefreshToken {
  id String @id @default(cuid())

  /// SHA-256 of the token, never the token itself. A leaked database dump
  /// must not hand the attacker usable sessions — the same reasoning that
  /// applies to passwords.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  /// Set on logout or forced revocation. Non-null means unusable.
  revokedAt DateTime?

  /// Context for the "active sessions" screen and anomaly review.
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A named set of permissions, e.g. SUPER_ADMIN, ADMIN, KITCHEN, STAFF.
model Role {
  id String @id @default(cuid())

  name        String  @unique
  description String?
  /// Built-in roles the Super Admin UI must not allow deleting or renaming.
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

/// A single capability, addressed as "subject:action" (e.g. "order:update").
model Permission {
  id String @id @default(cuid())

  /// Stable machine key checked by middleware. Never display this raw.
  key         String  @unique
  /// UI grouping for the Permission Management screen, e.g. "Orders".
  group       String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@index([group])
  @@map("permissions")
}

/// Explicit Role <-> Permission join.
///
/// Prisma supports implicit many-to-many, which would remove this model
/// entirely. It is explicit here because granting a permission is an
/// auditable administrative act, and an implicit join table has nowhere to
/// record who granted it or when.
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ===========================================================================
// Menu
// ===========================================================================

model Category {
  id String @id @default(cuid())

  name        String  @unique
  /// URL-safe identifier used by the customer menu filter.
  slug        String  @unique
  description String?
  imageUrl    String?
  /// Manual display order; menus are not alphabetical.
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  foods Food[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Food {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?

  /// The LIST price — what the dish costs with no offer running.
  ///
  /// Its meaning is unchanged by the offer columns below: this stays the
  /// original price, and an offer never rewrites it. That is what lets the
  /// menu show "was ₹500, now ₹400" and what lets an offer be switched off
  /// without having to remember what the price used to be.
  price    Decimal @db.Decimal(10, 2)
  imageUrl String?

  // -- Promotional offer ----------------------------------------------------
  //
  // Four columns rather than one discounted price, because a price alone
  // cannot answer "20% off, or ₹100 off?" — and the badge on the customer
  // menu has to say which.

  /// Master switch. False (the default) means the dish sells at `price`, and
  /// the columns below are ignored entirely rather than deleted — so a
  /// seasonal offer can be switched back on without re-entering it.
  isOfferActive Boolean    @default(false)
  offerType     OfferType?
  /// A percentage (0-100) when offerType is PERCENTAGE, otherwise an amount
  /// of money. Kept as Decimal for both: a percentage is exact decimal data
  /// for the same reason a price is.
  offerValue    Decimal?   @db.Decimal(10, 2)

  /// The final price after the discount — DERIVED, never client-supplied.
  ///
  /// Persisted rather than computed on every read for two reasons: the
  /// customer menu sorts and filters on what a dish actually costs, and a
  /// derivation that lives only in application code would be recomputed by
  /// every consumer and eventually disagree with itself. The service is the
  /// single writer, so it cannot drift from offerType/offerValue.
  offerPrice    Decimal?   @db.Decimal(10, 2)

  /// Optional badge wording, e.g. "Limited Time Offer". Blank falls back to a
  /// label derived from the discount itself ("20% OFF"), so an admin never has
  /// to type one to get a sensible badge.
  offerLabel    String?

  isAvailable        Boolean @default(true)
  isVegetarian       Boolean @default(false)
  /// Chef's recommendation. Drives the featured section of the welcome page.
  ///
  /// A flag on Food rather than a separate "featured items" table: a dish is
  /// either recommended tonight or it is not, there is nothing else to record
  /// about the fact, and a join table would let a featured row outlive the
  /// dish it points at.
  isFeatured         Boolean @default(false)
  /// Feeds the kitchen's estimated ready time.
  preparationMinutes Int?

  categoryId String
  /// Restrict: a category containing foods cannot be deleted outright.
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
  @@index([isAvailable, deletedAt])
  // The welcome page asks for "featured, still on the menu" on every visit.
  @@index([isFeatured, deletedAt])
  // "What is on offer right now", for the menu's offers filter.
  @@index([isOfferActive, deletedAt])
  @@map("foods")
}

// ===========================================================================
// Tables & QR codes
// ===========================================================================

model Table {
  id String @id @default(cuid())

  /// Human label shown to staff, e.g. "T-12".
  tableNumber String      @unique
  capacity    Int         @default(4)
  status      TableStatus @default(AVAILABLE)

  /// Unguessable token embedded in the QR URL. Separate from `id` so a QR
  /// code can be rotated (e.g. after a leak) without touching the table row
  /// or breaking historical orders that reference it.
  qrToken    String  @unique @default(cuid())
  qrImageUrl String?

  isActive Boolean @default(true)

  orders       Order[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("tables")
}

// ===========================================================================
// Customers
//
// Guest-first: no credentials. A diner scans, orders, and leaves. Optional
// contact details identify returning customers and power order tracking.
// ===========================================================================

model Customer {
  id String @id @default(cuid())

  name  String?
  /// Unique to allow upserting a returning diner. Postgres permits multiple
  /// NULLs under a unique constraint, so fully anonymous orders remain valid.
  phone String? @unique
  email String?

  orders       Order[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

// ===========================================================================
// Orders
// ===========================================================================

model Order {
  id String @id @default(cuid())

  /// Short human-readable reference shown to customers and kitchen staff.
  /// Distinct from `id`: staff must be able to read it aloud.
  ///
  /// It comes from a sequence, so it is ENUMERABLE and must never be treated
  /// as a secret. Anything a diner is entitled to see and no one else is keyed
  /// on `trackingToken` below.
  orderNumber String @unique

  /// Unguessable per-order secret, handed to the diner once when the order is
  /// placed. The public tracking page, the invoice and the online payment flow
  /// are all keyed on this.
  ///
  /// Separate from `id` for the same reason Table.qrToken is: this value
  /// travels in URLs and can be rotated, whereas an id is referenced by other
  /// rows and cannot.
  trackingToken String @unique

  status        OrderStatus    @default(PENDING)
  type          OrderType      @default(DINE_IN)
  paymentStatus PaymentStatus  @default(UNPAID)
  paymentMethod PaymentMethod?

  /// Totals are persisted rather than recomputed on read: tax rates and menu
  /// prices change, and an invoice must always reproduce its original figures.
  subtotal       Decimal @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  notes String?

  /// Nullable: takeaway orders have no table.
  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  /// Nullable: a fully anonymous order is valid.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Staff member who accepted the order, for accountability.
  handledById String?
  handledBy   User?   @relation("OrderHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  items    OrderItem[]
  payments Payment[]

  /// Status transition timestamps. Kept as discrete columns rather than
  /// derived from an event log so KDS timings and reports stay simple.
  placedAt     DateTime  @default(now())
  confirmedAt  DateTime?
  preparedAt   DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The KDS polls open orders constantly; this is its query path.
  @@index([status, placedAt])
  @@index([tableId])
  @@index([customerId])
  @@index([handledById])
  @@index([createdAt])
  @@map("orders")
}

/// A line on an order.
///
/// foodName and unitPrice are SNAPSHOTS taken at purchase time. Reading them
/// live from Food would rewrite financial history whenever the menu changes.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  /// Cascade: line items have no meaning without their order.
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  foodId String
  /// Restrict: a food item that appears in an order is never hard-deleted.
  /// Use the soft delete (deletedAt) on Food instead.
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Restrict)

  /// Snapshot of Food.name at purchase time.
  foodName  String
  /// Snapshot of Food.price at purchase time.
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  /// unitPrice * quantity, persisted so invoices never depend on recomputation.
  lineTotal Decimal @db.Decimal(10, 2)

  /// Per-item instruction, e.g. "no onions".
  notes String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([foodId])
  @@map("order_items")
}

// ===========================================================================
// Audit & notifications
// ===========================================================================

/// Append-only record of privileged actions.
///
/// Deliberately has no updatedAt and no update path: an audit trail that can
/// be edited is not an audit trail.
model AuditLog {
  id String @id @default(cuid())

  /// Null for system-generated actions with no human actor.
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// Dotted verb, e.g. "food.update", "user.login".
  action   String
  /// Model name the action targeted, e.g. "Food".
  entity   String
  entityId String?

  /// Snapshots for diffing. Never store password hashes or tokens here.
  before Json?
  after  Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id String @id @default(cuid())

  /// Null means a broadcast to all staff.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  /// Who has read it. Read state is per staff member — see NotificationRead.
  reads NotificationRead[]

  /// Payload for deep-linking, e.g. { "orderId": "..." }.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

/// One staff member having read one notification.
///
/// Read state CANNOT live on Notification itself. Almost every notification is
/// a broadcast, so a single isRead flag meant the first person to open the bell
/// marked it read for the entire team — the chef clearing their list hid the
/// new order from every waiter. A row per (notification, user) is the only
/// shape that lets each person have their own unread count.
model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  /// Composite key: reading the same notification twice is idempotent, not a
  /// second row.
  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

// ===========================================================================
// Restaurant settings
// ===========================================================================

/// Single-row configuration table.
///
/// The fixed id default enforces the singleton: every write targets
/// id = "singleton", so a second settings row cannot be created by accident.
model RestaurantSettings {
  id String @id @default("singleton")

  name    String  @default("My Restaurant")
  tagline String?
  logoUrl String?

  email       String?
  phone       String?
  addressLine String?
  city        String?
  state       String?
  postalCode  String?
  country     String?

  /// ISO 4217 code. Formatting is a presentation concern, not stored here.
  currency              String  @default("INR")
  taxPercent            Decimal @default(0) @db.Decimal(5, 2)
  serviceChargePercent  Decimal @default(0) @db.Decimal(5, 2)

  /// Master switch for accepting new orders.
  isAcceptingOrders Boolean @default(true)
  /// "HH:mm" local time. Stored as text because these are wall-clock hours,
  /// not instants, and must not shift with timezones or DST.
  openingTime       String?
  closingTime       String?

  updatedAt DateTime @updatedAt

  @@map("restaurant_settings")
}

// ===========================================================================
// Content management
// ===========================================================================

/// Editable copy for the public welcome page — the CMS.
///
/// Single-row, exactly as RestaurantSettings is, and for the same reason: the
/// fixed id default makes every write target id = "singleton", so a second
/// row of site copy cannot appear and leave two pages of truth.
///
/// Deliberately a fixed set of NAMED columns rather than a generic
/// key/value blob. Every field here corresponds to one slot the welcome page
/// actually renders; a free-form store would let an editor add a key nothing
/// reads and silently lose their work, and would give the admin form nothing
/// to label its inputs with.
///
/// Every column is nullable and the page falls back to its built-in copy when
/// one is blank, so an empty CMS renders exactly as the site did before it
/// existed — nobody has to fill in nine boxes before the site works.
model SiteContent {
  id String @id @default("singleton")

  /// Hero — the first screen of the welcome page.
  heroEyebrow String?
  heroTitle   String?
  /// Overrides RestaurantSettings.tagline on the hero when set.
  heroLede    String? @db.Text

  /// A promotional strip beneath the hero. Hidden entirely when blank.
  bannerText String?

  /// "Featured" / chef's recommendation section headings. The DISHES shown
  /// there come from Food.isFeatured — this is only the copy around them.
  featuredEyebrow String?
  featuredTitle   String?
  featuredLede    String? @db.Text

  /// The restaurant description block.
  aboutEyebrow String?
  aboutTitle   String?
  aboutBody    String? @db.Text

  /// Closing note in the footer.
  footerNote String? @db.Text

  updatedAt DateTime @updatedAt

  @@map("site_content")
}

/// A customer testimonial shown on the welcome page.
///
/// Curated, not user-submitted: reviews are written and published by the
/// house through the admin panel. That is why there is no rate limiter, no
/// moderation queue and no link to Customer — a testimonial is marketing copy
/// with an attribution, not a record of a transaction.
///
/// `isVisible` is the publish switch. Hiding is preferred to deleting because
/// a review taken down for a season is usually wanted back.
model Review {
  id String @id @default(cuid())

  customerName String
  /// Optional portrait. Server-relative, e.g. `/uploads/abc.jpg`.
  imageUrl     String?

  /// 1-5. Constrained in the application layer; stored as a plain Int so the
  /// range can be widened without a migration.
  rating  Int    @default(5)
  comment String @db.Text

  /// When the guest dined. Optional: an undated testimonial is still usable.
  visitedOn DateTime?

  /// Only visible reviews reach the public endpoint.
  isVisible Boolean @default(true)
  /// Manual display order, as on Category. Testimonials are curated, so the
  /// house decides which one leads.
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The public carousel queries exactly this.
  @@index([isVisible, sortOrder])
  @@map("reviews")
}

// ===========================================================================
// Payments
// ===========================================================================

/// A payment attempt against an order.
///
/// Kept as its own record rather than only flags on Order, so the full
/// payment history is queryable (the super admin views it) and a receipt can
/// be reproduced. An order may have more than one row — e.g. a failed online
/// attempt followed by a successful one, or a refund.
///
/// `provider` names who processed it ("mock" for the built-in demo gateway,
/// "razorpay" once real keys are configured). `providerRef` is that provider's
/// own transaction id. Swapping the provider changes these values, not the
/// shape of this table.
model Payment {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Exact amount captured. See the money note at the top of this file.
  amount Decimal @db.Decimal(10, 2)

  method   PaymentMethod
  status   PaymentTxnStatus @default(PENDING)
  provider String           @default("mock")

  /// The provider's transaction reference, for reconciliation.
  providerRef String?

  /// Human-readable receipt number shown to the customer.
  receiptNumber String? @unique

  /// Refund trail. A refund reverses THIS row rather than creating a negative
  /// one, so "collected" stays a simple sum over SUCCESS and can never be
  /// double-counted.
  refundedAt   DateTime?
  refundReason String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// ===========================================================================
// Reservations
// ===========================================================================

/// A table booking.
///
/// Deliberately NOT tied to a Table at creation. A guest books a time and a
/// party size; which table they get is an operational decision the house makes
/// on the night, often minutes before they arrive. Assigning a specific table
/// weeks ahead would make every later floor change a data migration.
model Reservation {
  id String @id @default(cuid())

  /// Short human-readable code the guest quotes on arrival.
  reference String @unique

  /// Contact details are stored on the booking itself, not only on Customer,
  /// so a reservation still reads correctly if the guest record is merged or
  /// edited later.
  name  String
  phone String
  email String?

  partySize Int
  /// The instant the table is held for, stored in UTC.
  reservedAt      DateTime
  /// How long the table is blocked; drives overlap checks.
  durationMinutes Int      @default(90)

  status   ReservationStatus @default(PENDING)
  /// Birthday, anniversary — lets the house prepare something.
  occasion String?
  notes    String?

  /// Assigned when the party is seated, or earlier by staff if they choose.
  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  /// Links a returning guest by phone, so their history accumulates.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  confirmedAt  DateTime?
  seatedAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The floor view queries "today, still active" constantly.
  @@index([reservedAt, status])
  @@index([phone])
  @@index([tableId])
  @@map("reservations")
}
